[Unit]
Description=Xtream IPTV Python Server
After=network.target

[Service]
Type=simple
# Set User to an account that can read config.json and the media directories.
# Replace the install path below. Media directories live in config.json.
WorkingDirectory=/path/to/xtream-server
ExecStart=/usr/bin/python3 /path/to/xtream-server/server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
